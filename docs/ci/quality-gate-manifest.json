{
  "schema_version": 1,
  "check_name": "CI / Quality Gate",
  "status_model": ["UNVERIFIED", "OFF", "SHADOW", "ENFORCED"],
  "fail_closed": true,
  "events": ["pull_request", "push", "merge_group"],
  "required_steps": [
    "Verify locked metadata",
    "Check formatting",
    "Check workspace",
    "Run tests",
    "Run Clippy",
    "Build rustdoc",
    "Check documentation authority",
    "Check documentation tests",
    "Run security baseline tests",
    "Check security baseline",
    "Run threat regression gate tests",
    "Validate threat regression manifest",
    "PR-026 real Servo contract",
    "Validate real Servo evidence",
    "Check architecture graph",
    "Run MVP smoke harness",
    "Check quality-gate evidence manifest",
    "Check quality-gate manifest tests",
    "Run shell bootstrap acceptance tests",
    "Run shell contract acceptance tests",
    "Run release manifest tests"
  ],
  "evidence_fields": [
    "repository",
    "event",
    "base_sha",

    "tree_sha",
    "run_id",
    "attempt",
    "workflow_revision",
    "status",
    "steps"
  ]
}
