{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Browser",
  "version": "0.1.0",
  "identifier": "com.example.browser",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Browser",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: asset:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; frame-src 'none'; media-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macos": {
      "dmg": {
        "applications": [{ "name": "Applications", "path": "/Applications" }],
        "bundleIdentifier": "com.example.browser"
      }
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}